// ============================================================
// ПОЛЗУНОК ПЕРЕКЛЮЧАТЕЛЯ
// ============================================================

wall_t   = 1.7;
hole_l   = 8.0;
hole_w   = 3.7;
switch_h = 2.0;

pin_w = 1.8;
pin_l = 3.3;

tolerance = 0.15;


// ============================================================
// РАЗМЕРЫ
// ============================================================

leg_l = hole_l - switch_h - tolerance * 2;
leg_w = hole_w - tolerance * 2;
leg_h = wall_t + 0.9;

cap_l = hole_l + 5.0;
cap_w = hole_w + 2.5;
cap_h = 1.5;

tooth_out = 0.5;
tooth_h   = 0.8;


// ============================================================
translate([0, 0, leg_h + cap_h])
    rotate([0, 180, 0])
        main_slider();


// ============================================================

module main_slider()
{
    difference()
    {
        union()
        {
            // ------------------------------------------------
            // ШЛЯПКА
            // ------------------------------------------------

            translate([
                -cap_l/2,
                -cap_w/2,
                leg_h
            ])
                cube([
                    cap_l,
                    cap_w,
                    cap_h
                ]);


            // ------------------------------------------------
            // ОСНОВНАЯ НОЖКА
            // ------------------------------------------------

            translate([
                -leg_l/2,
                -leg_w/2,
                -1
            ])
                cube([
                    leg_l,
                    leg_w,
                    leg_h + 1
                ]);


            // ------------------------------------------------
            // НАРУЖНЫЕ ЗУБЬЯ СО СКОСОМ
            // ------------------------------------------------

            translate([
                -leg_l/2,
                leg_w/2,
                0
            ])
                translate([leg_l/2, tooth_out/2, tooth_h/2])
                    rotate([0, 180, 0])
                        translate([-leg_l/2, -tooth_out/2, -tooth_h/2])
                            snap_tooth(leg_l);


            translate([
                -leg_l/2,
                -leg_w/2,
                0
            ])
                mirror([0,1,0])
                translate([leg_l/2, tooth_out/2, tooth_h/2])
                    rotate([0, 180, 0])
                        translate([-leg_l/2, -tooth_out/2, -tooth_h/2])
                    snap_tooth(leg_l);
        }


        // ====================================================
        // ПОСАДОЧНОЕ МЕСТО ПОД ДВИЖОК
        // ====================================================

        translate([
            -pin_l/2,
            -(pin_w + 2*tolerance)/2,
            -2
        ])
            cube([
                pin_l,
                pin_w + 10*tolerance,
                leg_h + 2
            ]);


        // ====================================================
        // БОКОВОЙ ВХОД
        // ====================================================

        translate([
            -pin_l/2,
            leg_w/2 - 0.01,
            -0.01
        ])
            cube([
                pin_l,
                leg_w/2 + tooth_out + 0.02,
                leg_h + 0.02
            ]);
    }
}


// ============================================================
// ЗУБ ЗАЩЁЛКИ
//
// Внутренняя сторона вертикальная.
// Наружная сторона имеет скос.
//
//              ножка
//                │
//                │
//                ├──────┐
//                │      ╲
//                │       ╲
//                │        └──
//                │
// ============================================================

module snap_tooth(l)
{
    polyhedron(
        points = [
            // Внутренняя сторона
            [0, 0,         0],
            [l, 0,         0],

            // Наружная нижняя точка
            [0, tooth_out, 0],
            [l, tooth_out, 0],

            // Верхняя точка
            [0, 0,         tooth_h],
            [l, 0,         tooth_h]
        ],

        faces = [
            // Нижняя грань
            [0, 1, 3, 2],

            // Внутренняя вертикальная грань
            [0, 4, 5, 1],

            // Наружный скос
            [2, 3, 5, 4],

            // Торец
            [0, 2, 4],

            // Торец
            [1, 5, 3]
        ]
    );
}